# Configuration for the Docker Compose deployment.
# Copy to .env and edit before running `docker compose up -d --build`.
#
#   cp .env.example .env
#
# .env is gitignored — it holds this machine's address and secret key.

# ---------------------------------------------------------------------------
# REQUIRED: the address browsers will use to reach this server.
#
# Set it to the machine's LAN IP or hostname. Everything the backend needs to
# accept a request from elsewhere on the network is derived from this one
# value: ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, and CSRF_TRUSTED_ORIGINS.
#
# Leaving it at localhost is the single most common cause of the browser
# reporting "NetworkError when attempting to fetch resource" from another
# machine — the request is refused before any of the app's code runs.
#
# A bare hostname is expected, but a pasted URL is cleaned up rather than
# rejected: "http://192.168.2.17:8001/" is read as "192.168.2.17".
# Comma-separate to accept several (a LAN IP and a hostname, say).
# ---------------------------------------------------------------------------
SERVER_HOSTS=192.168.2.17,localhost,127.0.0.1

# ---------------------------------------------------------------------------
# REQUIRED: Django's secret key. Generate a fresh one per deployment:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-real-one

# ---------------------------------------------------------------------------
# Ports. Change these and SERVER_HOSTS stays the only other thing to touch —
# the derived CORS origins follow FRONTEND_PORT automatically.
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8001

# Leave off in normal use. Turning it on exposes stack traces containing live
# site data to anyone who can reach the server, but it is the fastest way to
# see why a request is being rejected while first bringing the server up.
DJANGO_DEBUG=False
