# Configuration for the Docker Compose deployment.
# Copy to .env and edit before starting:
#
#   cp .env.example .env
#
# .env is gitignored - it holds this deployment's address and secret key.

# ---------------------------------------------------------------------------
# REQUIRED: the address the reverse proxy publishes the app on.
#
# This is the URL people will type. Nginx Proxy Manager (or Traefik, or Caddy)
# forwards the browser's Host header unchanged, so Django has to be told to
# accept this name or it answers 400 to every request arriving through the
# proxy - which the browser shows only as a failure to load.
#
# The whole app lives at this one address: the frontend container proxies
# /api, /admin, and /static to the backend, so the browser never makes a
# cross-origin request and CORS is never involved.
#
# Switch to https:// when you put a certificate on it in NPM, and Django's
# proxy-aware TLS settings turn themselves on. Nothing else changes.
# ---------------------------------------------------------------------------
PUBLIC_ORIGIN=http://canteen.lan

# ---------------------------------------------------------------------------
# REQUIRED: Django's secret key. Generate a fresh one per deployment:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-real-one

# ---------------------------------------------------------------------------
# The Docker network Nginx Proxy Manager runs on, so it can reach the frontend
# container by name. Find it with:
#
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <npm-container>
#
# In NPM, add one proxy host: forward to "canteen-frontend" on port 80.
# No custom locations are needed.
# ---------------------------------------------------------------------------
NPM_NETWORK=npm_default

# Leave off in normal use. Turning it on exposes stack traces containing live
# site data to anyone who can reach the app, but it is the quickest way to see
# why a request is being rejected while first bringing the deployment up.
DJANGO_DEBUG=False

# ---------------------------------------------------------------------------
# Only for docker-compose.direct.yml, which publishes a port instead of going
# through a proxy. Set SERVER_HOSTS to this machine's LAN address:
#
#   docker compose -f docker-compose.direct.yml up -d --build
#   -> http://192.168.2.17:5173
# ---------------------------------------------------------------------------
# SERVER_HOSTS=192.168.2.17,localhost,127.0.0.1
# FRONTEND_PORT=5173
# BACKEND_PORT=8001
