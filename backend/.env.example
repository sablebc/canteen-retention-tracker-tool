# Configuration for running the backend directly (without Docker), e.g. for
# local development. Copy to backend/.env and edit:
#
#   cp backend/.env.example backend/.env
#
# Docker Compose deployments use the repo-root .env instead; see .env.example
# there. This file is read by settings.py via python-dotenv.

# ---------------------------------------------------------------------------
# The address browsers will use to reach this server. ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS, and CSRF_TRUSTED_ORIGINS are all derived from it, so
# they cannot drift out of step with one another.
#
# Set it to the machine's LAN IP when other computers need access. A pasted
# URL is cleaned up rather than rejected.
# ---------------------------------------------------------------------------
SERVER_HOSTS=localhost,127.0.0.1

# Used to build the derived CORS origins; match your Vite/nginx port.
FRONTEND_PORT=5173
BACKEND_PORT=8001

# ---------------------------------------------------------------------------
# Generate a real key for anything but local development:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
# DJANGO_SECRET_KEY=

# On by default for local work. Never leave it on where others can reach it.
DJANGO_DEBUG=True

# ---------------------------------------------------------------------------
# Escape hatches, only needed when the derived values are wrong for your setup
# (a reverse proxy on port 80, a second frontend origin). Setting either one
# replaces the derived list entirely, so include every value you need.
# ---------------------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=192.168.2.17,canteen.local
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.2.17:5173,http://canteen.local

# Where the SQLite file and uploaded tracker exports live.
# DJANGO_DB_PATH=/data/db.sqlite3
# TRACKER_UPLOAD_DIR=/data/uploads
# TRACKER_UPLOAD_MAX_BYTES=26214400
